{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cause-gen.local/schemas/latex-problem-intake-classification.schema.json",
  "title": "Cause Gen LaTeX Problem Intake Classification",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "source_intakes",
    "classifications"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "source_intakes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string"
    },
    "classifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "problem_id",
          "source_intake_file",
          "source_title",
          "statement",
          "classification_status",
          "needs_human_review",
          "approval_status",
          "confidence",
          "proposed"
        ],
        "properties": {
          "problem_id": {
            "type": "string"
          },
          "source_intake_file": {
            "type": "string"
          },
          "source_title": {
            "type": "string"
          },
          "part_label": {
            "type": "string"
          },
          "raw_label": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "classification_status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved",
              "rejected"
            ]
          },
          "needs_human_review": {
            "type": "boolean"
          },
          "approval_status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "reviewed_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "approved_target_destination": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "proposed": {
            "type": "object",
            "required": [
              "topic",
              "module_id",
              "clo_id",
              "bloom_level",
              "likely_techniques",
              "answer_type",
              "is_multi_step",
              "misconception_tags",
              "suitable_for",
              "problem_type",
              "target_skill"
            ],
            "properties": {
              "topic": {
                "type": "string"
              },
              "module_id": {
                "type": "string"
              },
              "clo_id": {
                "type": "string"
              },
              "bloom_level": {
                "type": "string"
              },
              "likely_techniques": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "answer_type": {
                "type": "string"
              },
              "is_multi_step": {
                "type": "boolean"
              },
              "misconception_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "suitable_for": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sbra_profile": {
                "type": "object",
                "properties": {
                  "candidate_strength": {
                    "type": "string",
                    "enum": [
                      "strong",
                      "medium",
                      "weak",
                      "not_recommended"
                    ]
                  },
                  "evidence_role": {
                    "type": "string",
                    "enum": [
                      "primary-clo-evidence",
                      "support-clo-evidence",
                      "practice-or-check",
                      "not-recommended"
                    ]
                  },
                  "recommended_step_count": {
                    "type": "integer"
                  },
                  "pattern_tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "distractor_focus": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "problem_type": {
                "type": "string"
              },
              "target_skill": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "review_notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
